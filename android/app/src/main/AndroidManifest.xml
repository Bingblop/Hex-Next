<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BootReceiver records each boot id for the boot-loop safe mode (safety/ApplyGuard). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only for "Theme restored" after a restart (theme/RestoreNotice); never required. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Theme pack catalogue downloads (theme/PackStore). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The theme restore after a restart runs as a foreground service (theme/RestoreService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Package visibility (targetSdk 30+): lets "Open Shizuku" find the Shizuku manager's
         launch intent instead of falling back to the download page. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- The Play and owner builds detect each other (safety/OtherBuild.kt). -->
        <package android:name="com.hexnext.themer" />
        <package android:name="com.hexnext.themer.owner" />
    </queries>

    <!-- largeHeap is a safety margin only; the apply path itself keeps per-target tables small. -->
    <!-- dataExtractionRules keeps the encrypted AI provider keys and the device-specific
         scan, reports, packs and apply-guard state out of backups and transfers. -->
    <application
        android:name=".HexNextApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.HexNext">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the Shizuku app hand this app its binder. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Shares files/reports and files/logs (device reports, build logs). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".theme.RestoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Re-applies the user's theme overlays after Android dropped them on a restart." />
        </service>

        <receiver
            android:name=".safety.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
