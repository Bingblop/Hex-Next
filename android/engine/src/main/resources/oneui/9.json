  "renamed": {
    "drawable/ic_settings_display": "drawable/sec_ic_settings_display",
    "drawable/ic_settings_sound": "drawable/sec_ic_settings_sound",
    "drawable/ic_settings_applications": "drawable/sec_ic_settings_applications",
    "drawable/ic_settings_location": "drawable/sec_ic_settings_location",
    "drawable/ic_settings_about": "drawable/sec_ic_settings_about",
    "drawable/ic_settings_accessibility": "drawable/sec_ic_settings_accessibility",
    "drawable/ic_settings_privacy": "drawable/sec_ic_settings_privacy",
    "drawable/ic_settings_themes": "drawable/sec_ic_settings_themes",
    "drawable/ic_theme": "drawable/sec_ic_settings_themes",
    "drawable/sec_ic_themes": "drawable/sec_ic_settings_themes",
    "drawable/sec_ic_settings_help": "drawable/sec_ic_settings_user_manual"
  },
  "dashboardRows": [
    "cloud_and_account",
    "google",
    "connections",
    "devicecare",
    "applications",
    "display",
    "advanced_feature",
    "wallpaper",
    "general_device_management",
    "battery",
    "galaxy_ai",
    "sound",
    "notifications",
    "themes",
    "biometrics_and_security",
    "lockscreen",
    "accessibility",
    "location",
    "multi_devices",
    "emergency",
    "user_manual",
    "about",
    "digitalwellbeing",
    "homescreen",
    "modes",
    "software_update",
    "tips"
  ],
  "colorGroups": {
    "qs_tile_inactive": [
      "^(?!.*(icon|label|text|title|stroke)).*(^|_)tiles?_.*(inactive|(^|_)off(_|$)|unavailable|disabled|(^|_)dim(_|$))"
    ],
    "qs_tile_active": [
      "^(?!.*(icon|label|text|title|stroke)).*(^|_)tiles?_.*((?<!in)active|(^|_)on(_|$)|enabled|activated|checked)",
      "^(?!.*(icon|label|text|title|stroke|container|search|flashlight))(sec_)?qs_tiles?(_|$)"
    ],
    "qs_panel_bg": [
      "^(?!.*(tile|icon|text|title|label|stroke|divider)).*(^|_)qs_.*(background|bg)",
      "^(?!.*(tile|icon|text|title|label|stroke|divider))quick_?(settings?|panel).*(background|bg)",
      "^(?!.*(tile|icon|text|title|label|stroke|divider|volume|power|keyguard|lock)).*(panel_background|panel_bg|shade_background|shade_bg)"
    ],
    "notification_bg": [
      "^(?!.*(icon|text|title|label|stroke|divider|button|btn)).*notifi(cation)?s?_.*(bg|background|card)",
      "^(?!.*(icon|text|title|label|stroke|divider|button|btn)).*notifi(cation)?s?_?(bg|background)",
      "notification_guts"
    ],
    "system_bars": [
      "^(?!.*(icon|text|title|label|stroke|divider|button|btn|ripple|shadow)).*(navigation_?bar|nav_?bar|status_?bar)"
    ],
    "slider": [
      "^(?!.*(icon|text|title|label|loading|swipe_refresh|stroke|flashlight)|.*(dialog|panel|window)_?(background|bg)).*(brightness|volume|seek_?bar|slider|progress|tick_?mark|level_control)"
    ],
    "switch": [
      "^(?!.*(text|title|label|icon|flashlight)).*(switch|checkbox|check_box|radio|toggle|(^|_)thumb|(^|_)track|_on_mtrl|_off_mtrl)"
    ],
    "button": [
      "^(?!.*(text|title|label|icon|stroke)).*(button|(^|_)btn)"
    ],
    "icon_tint": [
      "^(?!.*((background|bg|bgcolor)(_color)?(_(dark|light))?$|button|btn)).*(^|_)icons?(_|$)"
    ],
    "dialog": [
      "^(?!.*(text|title|label|icon|stroke|divider|button|btn)).*(dialog|popup|pop_up|bottom_?sheet|menu_(bg|background)|tooltip|snackbar|toast)"
    ],
    "accent": [
      "^(?!.*(background|bg|bgcolor)(_color)?(_(dark|light))?$).*(link|highlight|(?<!un)selected|activated|accent|primary_color|color_primary|primary_dark|control_activated|indicator|loading_progress|swipe_refresh)"
    ],
    "text_secondary": [
      "^(?!.*((background|bg|bgcolor)(_color)?(_(dark|light))?$|icon|button|btn)).*(summary|subtitle|sub_?text|(^|_)sub(_|$)|secondary|hint|description|caption|state_text|chart.*text|empty_text)"
    ],
    "text_primary": [
      "^(?!.*((background|bg|bgcolor)(_color)?(_(dark|light))?$|icon|button|btn|cursor|shadow|stroke)).*(^|_)(text|texts|title|label|primary_text|foreground)(_|$|color)"
    ],
    "surface": [
      "^(?!.*(text|title|label|icon|stroke|divider|shadow|button|btn|thumb|track|seek|progress|tile|ripple|indicator)).*(card|container|list_bg|item_bg|app_?bar|action_?bar|tool_?bar|bottom_navigation|tab_?layout|search_view|cell)"
    ],
    "background": [
      "^(?!.*(text|title|label|icon|stroke|divider|shadow|button|btn|thumb|track|seek|progress|tile|ripple|indicator|highlight|selected)).*(background|bgcolor|(^|_)bg(_|$)|window|screen_bg)"
    ]
  },
  "colorGroupPackages": {
    "com.samsung.android.honeyboard": "keyboard",
    "com.samsung.android.dialer": "dialer",
    "com.samsung.android.incallui": "dialer",
    "com.samsung.android.app.aodservice": "aod",
    "com.android.systemui": "systemui"
  },
  "colorGroupFamilies": {
    "keyboard": {
      "groups": {
        "keyboard_key": [
          "^(?!.*(text|label|symbol|icon|hint|preview|shadow|stroke)).*(^|_)(keys?|keycap|key_cap|keybg|btn|button)(_|$)"
        ],
        "keyboard_bg": [
          "^(?!.*(text|label|symbol|icon|hint|(^|_)keys?(_|$)|btn|button|stroke)).*(background|(^|_)bg(_|$)|bgcolor|board|window|panel|toolbar|candidate)"
        ]
      },
      "remap": {
        "background": "keyboard_bg",
        "surface": "keyboard_key"
      }
    },
    "dialer": {
      "groups": {
        "dialer": [
          "^(?!.*(background|(^|_)bg(_|$)|bgcolor|text|title|label|divider|stroke)).*(^|_)(calls?|dial|dialer|dialpad|dial_pad|keypad|key_pad|answer|accept|incall|in_call|ongoing)(_|$)"
        ]
      },
      "remap": {
        "button": "dialer"
      }
    },
    "aod": {
      "groups": {
        "lock_screen": [
          "^(?!.*(background|(^|_)bg(_|$)|bgcolor|window|scrim|(^|_)dim(_|$)|shadow)).*"
        ]
      }
    },
    "systemui": {
      "exact": {
        "qs_tile_active": ["qs_tile_round_background_on", "qs_tile_round_background_on_stroke", "subscreen_qs_tile_round_background_on"],
        "qs_tile_inactive": ["qs_tile_round_background_dim", "qs_tile_round_background_off", "qs_tile_round_background_off_stroke", "subscreen_qs_tile_round_background_dim", "subscreen_qs_tile_round_background_off", "qs_edit_tile_round_background_available"],
        "qs_panel_bg": ["qs_tile_container_bg", "sec_panel_background_color", "sec_panel_background_color_tablet", "open_theme_qp_bg_color", "sec_brightness_mirror_background_color", "sec_qs_detail_bg_color", "qs_detail_background_color", "sec_qs_detailed_container_background", "qs_edit_panel_available_background_color"],
        "qs_tile_icon_on": ["qs_tile_icon_on_dim_tint_color", "subscreen_qs_tile_icon_on_color", "animated_brightness_sun_icon_color", "qs_edit_panel_active_tile_icon_color"],
        "qs_tile_icon_off": ["qs_tile_icon_off_tint_color", "subscreen_qs_tile_icon_off_color", "qs_edit_panel_tile_icon_color", "qs_edit_tile_icon_available", "qs_edit_panel_available_tile_icon_color"],
        "qs_text": ["qs_tile_label", "qs_tile_sub_label", "shade_header_clock_color", "shade_header_text_color", "qs_status_bar_clock_color", "sec_qs_header_tint_color", "qs_multisim_carrier_name_color", "qs_edit_tile_available_label_color", "qs_page_indicator_tint_color_selected", "sec_qs_page_indicator_tint_color", "qs_edit_content_text_color", "qs_detail_header_title", "qs_detail_item_name", "sec_qs_detail_header_text_color", "sec_qs_detail_primary_text_color", "sec_qs_detail_item_text_color"],
        "notification_bg": ["sec_qs_media_player_background_color", "sec_qs_media_player_guts_background_color", "qp_notification_background_color", "open_theme_notification_bg_color"],
        "text_primary": ["media_primary_text", "qp_notification_title_color", "open_theme_notification_title_text_color"],
        "text_secondary": ["media_secondary_text", "media_tertiary_text", "qp_notification_content_color", "open_theme_notification_content_text_color"]
      },
      "groups": {
        "lock_screen": [
          "^(?!.*(background|(^|_)bg(_|$)|bgcolor|scrim|shadow|(^|_)dim(_|$))).*(^|_)(keyguard|lockscreen|lock_screen|kg|aod|lock)(_|$)"
        ]
      }
    }
  }
}
