  "quickSettings": {
    "layout": "oneui9",
    "colours": [],
    "extraColours": [
      "open_theme_noti_header_color",
      "basic_token_sys_primary",
      "basic_list_button_ripple_background_color",
      "basic_interaction_no_item_text",
      "control_manage_apps_description",
      "control_spinner_item_text_color",
      "sec_wifi_icon_gray_color",
      "sesl_action_bar_text_color_subtitle_dark",
      "sesl_action_bar_text_color_subtitle_light",
      "sesl_extended_appbar_subtitle_dark",
      "sesl_extended_appbar_subtitle_light",
      "sesl_list_subheader_text_color",
      "sesl_list_subheader_text_color_dark"
    ],
    "drawablesAllowed": false,
    "_valuesNote": "Names confirmed on One UI 9.0 (SM-S948U1 scan, hexnext-values.txt 2026-11-03). The planner still writes only names the phone's scan lists, so a name missing on another build is skipped.",
    "values": {
      "tileCorner": {
        "type": "dimen",
        "names": [
          "com.android.systemui:dimen/common_tile_default_active_tile_corner_radius",
          "com.android.systemui:dimen/common_tile_default_inactive_tile_corner_radius",
          "com.android.systemui:dimen/common_tile_default_active_icon_corner_radius",
          "com.android.systemui:dimen/common_tile_default_inactive_icon_corner_radius",
          "com.android.systemui:dimen/qs_corner_radius"
        ],
        "min": 0,
        "max": 40,
        "unit": "DP"
      },
      "panelCorner": {
        "type": "dimen",
        "names": [
          "com.android.systemui:dimen/panel_bar_corner_radius",
          "com.android.systemui:dimen/panel_radius",
          "com.android.systemui:dimen/overlay_shade_panel_shape_radius",
          "com.android.systemui:dimen/notification_scrim_corner_radius"
        ],
        "min": 0,
        "max": 48,
        "unit": "DP"
      },
      "sliderThickness": {
        "type": "dimen",
        "names": [
          "com.android.systemui:dimen/rounded_slider_height",
          "com.android.systemui:dimen/brightness_slider_height",
          "com.android.systemui:dimen/brightness_slider_expanded_height",
          "com.android.systemui:dimen/brightness_tile_layout_height",
          "com.android.systemui:dimen/brightness_volume_area_height"
        ],
        "min": 24,
        "max": 64,
        "unit": "DP"
      },
      "notificationCorner": {
        "type": "dimen",
        "names": [
          "com.android.systemui:dimen/notification_corner_radius"
        ],
        "min": 0,
        "max": 40,
        "unit": "DP"
      }
    },
    "valueNames": []
